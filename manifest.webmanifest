{
  "name": "毒格巧克力 · CHOMP",
  "short_name": "毒格巧克力",
  "description": "网格巧克力，左上角有毒。每次咬掉一格连同它右下方的全部，被迫咬到毒格的人输。必胜/必败与必胜口数由穷举 minimax 量出。",
  "id": "/z-biz-game-chomp-cos/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "lang": "zh-CN",
  "dir": "ltr",
  "background_color": "#1b120c",
  "theme_color": "#241710",
  "categories": ["games", "puzzle"],
  "icons": [
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "density": "1x" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "density": "1x" },
    { "src": "assets/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/icons/apple-touch-icon.png", "sizes": "180x180", "type": "image/png" },
    { "src": "assets/icons/icon-1024.png", "sizes": "1024x1024", "type": "image/png" }
  ],
  "shortcuts": [
    { "name": "每日一题", "short_name": "每日", "url": "./#/daily", "icons": [{ "src": "assets/icons/icon-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "随机关卡", "short_name": "随机", "url": "./#/random", "icons": [{ "src": "assets/icons/icon-96.png", "sizes": "96x96", "type": "image/png" }] }
  ]
}
